# Copier ce fichier en .env et adapter une fois le labo (bloc 1) prêt.
# Tant que COLLECTOR_MODE=simulated, aucune des autres valeurs n'a
# besoin d'être correcte - les collecteurs utilisent les fixtures.

COLLECTOR_MODE=simulated
# COLLECTOR_MODE=real

# SNMP
# SNMP_COMMUNITY=public
SNMP_PORT=161
SNMP_TIMEOUT=2
SNMP_RETRIES=1

SNMPV3_USER=
SNMPV3_AUTH_KEY=
SNMPV3_PRIV_KEY=

# NETCONF
NETCONF_USERNAME=admin
NETCONF_PASSWORD=admin
NETCONF_PORT=830
NETCONF_TIMEOUT=10

# CLI (netmiko)
CLI_USERNAME=admin
CLI_PASSWORD=admin
CLI_DEVICE_TYPE=cisco_ios
CLI_TIMEOUT=10

# NetFlow
NFDUMP_BIN=/usr/bin/nfdump
NETFLOW_DATA_DIR=/var/netflow

# PCAP (contraintes de sécurité - ne pas augmenter sans raison documentée)
PCAP_MAX_DURATION_SECONDS=30
PCAP_MAX_PACKETS=1000
PCAP_OUTPUT_DIR=/tmp/pcap_captures

# Syslog
SYSLOG_LISTEN_HOST=0.0.0.0
SYSLOG_LISTEN_PORT=514
SYSLOG_FILE_PATH=/var/log/network_syslog.log

# Connectivité (plafonds de sécurité)
PING_MAX_COUNT=5
PING_TIMEOUT_SECONDS=2
TRACEROUTE_MAX_HOPS=20
TRACEROUTE_TIMEOUT_SECONDS=2

# QoS (OIDs SNMP, à adapter à la MIB des équipements)
QOS_PKTS_OID=1.3.6.1.4.1.9.9.166.1.15.1.1.3
QOS_DROPS_OID=1.3.6.1.4.1.9.9.166.1.15.1.1.13

# Détection d'anomalies (seuils déterministes)
ANOMALY_TOP_TALKER_RATIO=0.80
ANOMALY_MIN_AVG_PACKET_BYTES=100
ANOMALY_MIN_PACKETS=1000
ANOMALY_MAX_FLOWS=1000

# Sécurité du serveur MCP (voir docs/security.md)
SECURITY_ENABLED=true
# Secret HMAC des jetons JWT : 32 caractères minimum, à changer, jamais commité
JWT_SECRET=
# Jeton utilisé en transport stdio (généré par: python security/generate_token.py)
MCP_AUTH_TOKEN=
# AUDIT_LOG_FILE=audit.log
